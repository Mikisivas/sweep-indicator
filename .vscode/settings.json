{
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "tests", "-t", "tests", "-p", "test_*.py"],
  "python.analysis.extraPaths": ["."],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "[python]": {
    "editor.rulers": [100]
  }
}
