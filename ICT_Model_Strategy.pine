//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// ICT Model — Sweep + CISD STRATEGY  (auto entry on CISD, no manual retest)
//
// 4-pillar model:
//   1. Sweep of liquidity  — price wicks through a prior swing low/high (stops)
//   2. HTF Fair Value Gaps — 4H BISI/SIBI for HTF context (optional filter)
//   3. CISD                — a close through the opens of the sweep candle series
//   4. Order Block         — the sweep series becomes the entry zone
//
// WHAT CHANGED vs the indicator (the "retest" is removed):
//   The instant CISD confirms, the strategy ACTS — it no longer waits for you to
//   confirm a retest by hand:
//     • "Limit at entry line"  → drops a resting limit at E the moment CISD prints.
//                                Fills on any pullback; cancelled if unfilled
//                                within the CISD window. (default)
//     • "Market at CISD close" → enters immediately, to catch the moves that run
//                                to target WITHOUT ever retracing to the block.
//
// Compact labels:  E = entry · SL = stop · TP = take profit · CISD = confirmation
// ─────────────────────────────────────────────────────────────────────────────
strategy("ICT Model — Sweep + CISD Strategy", "ICT WINS",
     overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500,
     pyramiding = 0, calc_on_every_tick = false, process_orders_on_close = false,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.02)

// ─────────────────────────── Inputs ───────────────────────────
grpS = "Setup logic"
swingLen = input.int(5,  "Swing pivot strength (bars each side)", minval = 2,  group = grpS,
     tooltip = "A swing low/high needs this many higher-lows / lower-highs on each side. Its stops are the liquidity pool.")
maxWait  = input.int(20, "Max bars after sweep to confirm CISD",  minval = 1,  group = grpS,
     tooltip = "If price does not close through the CISD level within this many bars, the setup is dropped. Also the window a resting limit stays live.")
chainMax = input.int(30, "Max candles scanned for the CISD chain", minval = 3, group = grpS)

grpE = "Entry — retest REMOVED"
entryTrigger = input.string("Limit at entry line", "How to enter once CISD confirms",
     options = ["Limit at entry line", "Market at CISD close"], group = grpE,
     tooltip = "Limit = drop a resting order at E the moment CISD prints; fills on a pullback (misses runners that never retrace). Market = enter now to catch moves that run straight to target.")
entryMode = input.string("Order block edge (safer fill)", "Where the entry price (E) sits",
     options = ["Order block edge (safer fill)", "Order block 50% (mean threshold)"], group = grpE,
     tooltip = "Edge = near side of the order block, sits just under price so a shallow pullback fills it (catches more runners). 50% = middle of the block, better price but a deeper retrace is needed.")
cancelUnfilled = input.bool(true, "Cancel a limit that hasn't filled within the CISD window", group = grpE,
     tooltip = "Keeps stale limits from filling long after the setup is gone. Uses the same bar count as 'Max bars after sweep to confirm CISD'.")

grpT = "Trade levels"
tpMode   = input.string("Opposing liquidity", "Take profit target",
     options = ["Opposing liquidity", "Fixed reward:risk"], group = grpT,
     tooltip = "Opposing liquidity = the previous high/low the model aims for. Fixed = a multiple of the risk.")
rrTarget = input.float(2.0, "Reward:risk (fixed TP, or fallback)", minval = 0.5, step = 0.5, group = grpT)

grpH = "Higher-timeframe context"
htfTf        = input.timeframe("240",  "HTF for Fair Value Gaps", group = grpH,
     tooltip = "Default 240 = 4-hour, per the model. FVGs from this timeframe are drawn on your chart.")
showFvg      = input.bool(true,  "Show HTF FVGs (BISI = teal, SIBI = maroon)", group = grpH)
useHtfFilter = input.bool(false, "Only take setups whose sweep happens inside an HTF FVG", group = grpH)

grpV = "Visuals"
showTrade  = input.bool(true,  "Draw E / SL / TP lines", group = grpV)
showCard   = input.bool(true,  "Show compact trade card", group = grpV)
showOb     = input.bool(false, "Shade the order block zone", group = grpV)
maxKeep    = input.int(3, "Keep only the last N setups drawn", minval = 1, maxval = 30, group = grpV,
     tooltip = "Older E/SL/TP drawings are deleted automatically so the chart stays clean. Use 1 to show only the current setup.")
obBars     = input.int(24, "Extend lines / zone (bars)", minval = 5, group = grpV)
showInvLbl = input.bool(false, "Show '✗' on failed setups", group = grpV)
colSweep   = input.color(color.orange, "Sweep candle",              group = grpV)
colBull    = input.color(#00c853,      "Valid bullish CISD candle", group = grpV)
colBear    = input.color(#ff1744,      "Valid bearish CISD candle", group = grpV)
colDead    = input.color(color.gray,   "Invalid setup candle",      group = grpV)
colEntry   = input.color(#2962ff,      "Entry line",                group = grpV)

// ─────────────────── HTF Fair Value Gaps (BISI / SIBI) ───────────────────
// Only COMPLETED HTF bars are requested (offsets >= 1) with lookahead_on:
// the classic non-repainting idiom, consistent on historical and realtime bars.
[htfH3, htfL3, htfH1, htfL1] = request.security(syminfo.tickerid, htfTf,
     [high[3], low[3], high[1], low[1]], lookahead = barmerge.lookahead_on)
newHtfBar = timeframe.change(htfTf)

var array<box> bisiBoxes = array.new<box>()   // bullish gaps (support)
var array<box> sibiBoxes = array.new<box>()   // bearish gaps (resistance)

if showFvg and newHtfBar and barstate.isconfirmed
    if htfL1 > htfH3
        array.push(bisiBoxes, box.new(bar_index, htfL1, bar_index, htfH3,
             border_color = color.new(color.teal, 55), bgcolor = color.new(color.teal, 85),
             extend = extend.right, text = "4H BISI", text_color = color.new(color.teal, 40),
             text_size = size.tiny, text_halign = text.align_right))
    if htfH1 < htfL3
        array.push(sibiBoxes, box.new(bar_index, htfL3, bar_index, htfH1,
             border_color = color.new(color.maroon, 55), bgcolor = color.new(color.maroon, 85),
             extend = extend.right, text = "4H SIBI", text_color = color.new(color.maroon, 40),
             text_size = size.tiny, text_halign = text.align_right))

prune(array<box> boxes, bool bullishGap) =>
    if array.size(boxes) > 0
        for i = array.size(boxes) - 1 to 0
            b = array.get(boxes, i)
            filled = bullishGap ? close < box.get_bottom(b) : close > box.get_top(b)
            if filled
                box.set_extend(b, extend.none)
                box.set_right(b, bar_index)
                array.remove(boxes, i)
    if array.size(boxes) > 15
        box.delete(array.shift(boxes))

prune(bisiBoxes, true)
prune(sibiBoxes, false)

insideGaps(array<box> boxes, float px) =>
    bool ok = false
    for b in boxes
        if px <= box.get_top(b) and px >= box.get_bottom(b)
            ok := true
    ok

// ── Drawing bookkeeping: keep only the last `maxKeep` setups on the chart ──
var array<line>  tLines    = array.new<line>()
var array<int>   tLineGrp  = array.new<int>()
var array<label> tLabels   = array.new<label>()
var array<int>   tLabelGrp = array.new<int>()
var array<box>   tBoxes    = array.new<box>()
var array<int>   tBoxGrp   = array.new<int>()
var int          grpId     = 0

regLine(line l, int g) =>
    array.push(tLines, l)
    array.push(tLineGrp, g)
regLabel(label lb, int g) =>
    array.push(tLabels, lb)
    array.push(tLabelGrp, g)
regBox(box bx, int g) =>
    array.push(tBoxes, bx)
    array.push(tBoxGrp, g)

pruneTrades(int keep, int g) =>
    minGrp = g - keep + 1
    if array.size(tLines) > 0
        for i = array.size(tLines) - 1 to 0
            if array.get(tLineGrp, i) < minGrp
                line.delete(array.get(tLines, i))
                array.remove(tLines, i)
                array.remove(tLineGrp, i)
    if array.size(tLabels) > 0
        for i = array.size(tLabels) - 1 to 0
            if array.get(tLabelGrp, i) < minGrp
                label.delete(array.get(tLabels, i))
                array.remove(tLabels, i)
                array.remove(tLabelGrp, i)
    if array.size(tBoxes) > 0
        for i = array.size(tBoxes) - 1 to 0
            if array.get(tBoxGrp, i) < minGrp
                box.delete(array.get(tBoxes, i))
                array.remove(tBoxes, i)
                array.remove(tBoxGrp, i)

// One exact level: thin solid line + tiny right-side tag "E 1.2345"
f_level(int x1, float p, string tag, color c, int g) =>
    regLine(line.new(x1, p, bar_index + obBars, p, color = c, width = 1), g)
    regLabel(label.new(bar_index + obBars, p, tag + " " + str.tostring(p, format.mintick),
         style = label.style_label_left, color = color.new(c, 88), textcolor = c, size = size.tiny), g)

// ─────────────────────────── Swing liquidity ───────────────────────────
var float lastPivLow  = na   // sell-side liquidity resting below
var float lastPivHigh = na   // buy-side liquidity resting above
pl = ta.pivotlow(low, swingLen, swingLen)
ph = ta.pivothigh(high, swingLen, swingLen)
if not na(pl)
    lastPivLow := pl
if not na(ph)
    lastPivHigh := ph

// CISD level = open of the FIRST candle in the most recent run of down-closes
// (bullish setup) or up-closes (bearish setup).
chainBull() =>
    int i = 0
    while i < chainMax and close[i] >= open[i]
        i += 1
    float lvl = na
    int j = i
    while j < chainMax and close[j] < open[j]
        lvl := open[j]
        j += 1
    [lvl, j - 1]

chainBear() =>
    int i = 0
    while i < chainMax and close[i] <= open[i]
        i += 1
    float lvl = na
    int j = i
    while j < chainMax and close[j] > open[j]
        lvl := open[j]
        j += 1
    [lvl, j - 1]

[bullLvl, bullOff] = chainBull()
[bearLvl, bearOff] = chainBear()

// ─────────────────────── Setup state machines ───────────────────────
// state 0 = idle · 1 = liquidity swept, waiting for CISD close
var int   bullState      = 0
var float bullSweptLow   = na
var float bullCisd       = na
var int   bullSweepBar   = na
var int   bullChainStart = na
var bool  bullHtfOk      = false

var int   bearState      = 0
var float bearSweptHigh  = na
var float bearCisd       = na
var int   bearSweepBar   = na
var int   bearChainStart = na
var bool  bearHtfOk      = false

bool bullSweepNow = false
bool bullValidNow = false
bool bullFailNow  = false
bool bearSweepNow = false
bool bearValidNow = false
bool bearFailNow  = false

// ---- Bullish: sweep of sell-side liquidity → CISD close ABOVE ----
if bullState == 0 and not na(lastPivLow) and low < lastPivLow
    if not na(bullLvl) and bullLvl > low
        bullState      := 1
        bullSweptLow   := low
        bullCisd       := bullLvl
        bullSweepBar   := bar_index
        bullChainStart := bar_index - bullOff
        bullHtfOk      := insideGaps(bisiBoxes, low)
        bullSweepNow   := true
    lastPivLow := na
else if bullState == 1
    if close > bullCisd and (not useHtfFilter or bullHtfOk)
        bullValidNow := true
        bullState    := 0
    else if close < bullSweptLow or bar_index - bullSweepBar > maxWait
        bullFailNow := true
        bullState   := 0
    else
        bullSweptLow := math.min(bullSweptLow, low)

// ---- Bearish: sweep of buy-side liquidity → CISD close BELOW ----
if bearState == 0 and not na(lastPivHigh) and high > lastPivHigh
    if not na(bearLvl) and bearLvl < high
        bearState      := 1
        bearSweptHigh  := high
        bearCisd       := bearLvl
        bearSweepBar   := bar_index
        bearChainStart := bar_index - bearOff
        bearHtfOk      := insideGaps(sibiBoxes, high)
        bearSweepNow   := true
    lastPivHigh := na
else if bearState == 1
    if close < bearCisd and (not useHtfFilter or bearHtfOk)
        bearValidNow := true
        bearState    := 0
    else if close > bearSweptHigh or bar_index - bearSweepBar > maxWait
        bearFailNow := true
        bearState   := 0
    else
        bearSweptHigh := math.max(bearSweptHigh, high)

// ─────────────────── ORDERS + drawings — the moment CISD confirms ───────────────────
// Pending-limit trackers so an unfilled limit can be cancelled after the window.
var int  longPlacedBar    = na
var bool longLimitPending = false
var int  shortPlacedBar   = na
var bool shortLimitPending = false

// ---- LONG: CISD confirmed ----
if bullValidNow
    grpId += 1
    float entry = entryMode == "Order block edge (safer fill)" ? bullCisd : math.avg(bullCisd, bullSweptLow)
    float stop  = bullSweptLow
    float risk  = entry - stop
    bool  hasLiq = not na(lastPivHigh) and lastPivHigh > entry
    float tp    = tpMode == "Opposing liquidity" and hasLiq ? lastPivHigh : entry + rrTarget * risk
    float rr    = risk > 0 ? (tp - entry) / risk : na

    // webhook JSON (fully built here so no nested-placeholder substitution is needed)
    string entryMsg = '{"action":"buy","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period +
         '","order":"' + (entryTrigger == "Limit at entry line" ? "limit" : "market") +
         '","entry":' + str.tostring(entry, format.mintick) +
         ',"sl":' + str.tostring(stop, format.mintick) +
         ',"tp":' + str.tostring(tp, format.mintick) +
         ',"rr":"' + str.tostring(rr, "#.0#") + '"}'
    string exitMsg  = '{"action":"close","side":"long","symbol":"' + syminfo.ticker + '"}'

    strategy.cancel("S")                                   // drop any resting short limit
    if entryTrigger == "Limit at entry line"
        strategy.entry("L", strategy.long, limit = entry, alert_message = entryMsg)
        longLimitPending := true
    else
        strategy.entry("L", strategy.long, alert_message = entryMsg)
        longLimitPending := false
    strategy.exit("L x", from_entry = "L", stop = stop, limit = tp, alert_message = exitMsg)
    longPlacedBar := bar_index

    if showOb
        regBox(box.new(bullChainStart, bullCisd, bar_index + obBars, bullSweptLow,
             border_color = color.new(colBull, 55), bgcolor = color.new(colBull, 90)), grpId)
    if showTrade
        f_level(bullSweepBar, tp,    "TP", colBull,  grpId)
        f_level(bullSweepBar, entry, "E",  colEntry, grpId)
        f_level(bullSweepBar, stop,  "SL", colBear,  grpId)
    if showCard
        regLabel(label.new(bullSweepBar, stop,
             "L\nE  " + str.tostring(entry, format.mintick) +
             "\nSL " + str.tostring(stop, format.mintick) +
             "\nTP " + str.tostring(tp, format.mintick) +
             "\nRR " + str.tostring(rr, "#.0#"),
             style = label.style_label_up, color = color.new(colEntry, 15),
             textcolor = color.white, size = size.tiny, textalign = text.align_left), grpId)
    regLabel(label.new(bar_index, high, "CISD", style = label.style_label_down,
         color = color.new(colBull, 25), textcolor = color.white, size = size.tiny), grpId)
    pruneTrades(maxKeep, grpId)
    alert(entryMsg, alert.freq_once_per_bar)

// ---- SHORT: CISD confirmed ----
if bearValidNow
    grpId += 1
    float entry = entryMode == "Order block edge (safer fill)" ? bearCisd : math.avg(bearSweptHigh, bearCisd)
    float stop  = bearSweptHigh
    float risk  = stop - entry
    bool  hasLiq = not na(lastPivLow) and lastPivLow < entry
    float tp    = tpMode == "Opposing liquidity" and hasLiq ? lastPivLow : entry - rrTarget * risk
    float rr    = risk > 0 ? (entry - tp) / risk : na

    string entryMsg = '{"action":"sell","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period +
         '","order":"' + (entryTrigger == "Limit at entry line" ? "limit" : "market") +
         '","entry":' + str.tostring(entry, format.mintick) +
         ',"sl":' + str.tostring(stop, format.mintick) +
         ',"tp":' + str.tostring(tp, format.mintick) +
         ',"rr":"' + str.tostring(rr, "#.0#") + '"}'
    string exitMsg  = '{"action":"close","side":"short","symbol":"' + syminfo.ticker + '"}'

    strategy.cancel("L")                                   // drop any resting long limit
    if entryTrigger == "Limit at entry line"
        strategy.entry("S", strategy.short, limit = entry, alert_message = entryMsg)
        shortLimitPending := true
    else
        strategy.entry("S", strategy.short, alert_message = entryMsg)
        shortLimitPending := false
    strategy.exit("S x", from_entry = "S", stop = stop, limit = tp, alert_message = exitMsg)
    shortPlacedBar := bar_index

    if showOb
        regBox(box.new(bearChainStart, bearSweptHigh, bar_index + obBars, bearCisd,
             border_color = color.new(colBear, 55), bgcolor = color.new(colBear, 90)), grpId)
    if showTrade
        f_level(bearSweepBar, stop,  "SL", colBear,  grpId)
        f_level(bearSweepBar, entry, "E",  colEntry, grpId)
        f_level(bearSweepBar, tp,    "TP", colBull,  grpId)
    if showCard
        regLabel(label.new(bearSweepBar, stop,
             "S\nE  " + str.tostring(entry, format.mintick) +
             "\nSL " + str.tostring(stop, format.mintick) +
             "\nTP " + str.tostring(tp, format.mintick) +
             "\nRR " + str.tostring(rr, "#.0#"),
             style = label.style_label_down, color = color.new(colEntry, 15),
             textcolor = color.white, size = size.tiny, textalign = text.align_left), grpId)
    regLabel(label.new(bar_index, low, "CISD", style = label.style_label_up,
         color = color.new(colBear, 25), textcolor = color.white, size = size.tiny), grpId)
    pruneTrades(maxKeep, grpId)
    alert(entryMsg, alert.freq_once_per_bar)

// ---- Cancel resting limits that never filled inside the CISD window ----
if longLimitPending and strategy.position_size > 0
    longLimitPending := false
if cancelUnfilled and longLimitPending and not na(longPlacedBar) and bar_index - longPlacedBar > maxWait
    strategy.cancel("L")
    longLimitPending := false

if shortLimitPending and strategy.position_size < 0
    shortLimitPending := false
if cancelUnfilled and shortLimitPending and not na(shortPlacedBar) and bar_index - shortPlacedBar > maxWait
    strategy.cancel("S")
    shortLimitPending := false

// Optional failed-setup markers
if showInvLbl and bullFailNow
    label.new(bar_index, low, "✗", style = label.style_label_up,
         color = color.new(colDead, 60), textcolor = colDead, size = size.tiny)
if showInvLbl and bearFailNow
    label.new(bar_index, high, "✗", style = label.style_label_down,
         color = color.new(colDead, 60), textcolor = colDead, size = size.tiny)

// ─────────────────────────── Candle coloring ───────────────────────────
barcolor(bullSweepNow or bearSweepNow ? colSweep :
     bullValidNow ? colBull :
     bearValidNow ? colBear :
     bullFailNow or bearFailNow ? colDead : na)

plotshape(bullSweepNow, "Sell-side sweep", shape.triangleup,   location.belowbar, colSweep, size = size.tiny)
plotshape(bearSweepNow, "Buy-side sweep",  shape.triangledown, location.abovebar, colSweep, size = size.tiny)

// ─────────────────────────── Legend ───────────────────────────
var table lg = table.new(position.top_right, 2, 5, border_width = 1,
     bgcolor = color.new(color.black, 60), border_color = color.new(color.gray, 70))
if barstate.islast
    table.cell(lg, 0, 0, "■", text_color = colSweep)
    table.cell(lg, 1, 0, "Liquidity sweep", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(lg, 0, 1, "■", text_color = colBull)
    table.cell(lg, 1, 1, "Long CISD ✓", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(lg, 0, 2, "■", text_color = colBear)
    table.cell(lg, 1, 2, "Short CISD ✓", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(lg, 0, 3, "■", text_color = colDead)
    table.cell(lg, 1, 3, "Invalid (no CISD)", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(lg, 0, 4, "■", text_color = color.teal)
    table.cell(lg, 1, 4, "4H FVG (BISI/SIBI)", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)

// ─────────────────────────── Alerts ───────────────────────────
alertcondition(bullSweepNow or bearSweepNow, "Liquidity sweep",      "Liquidity sweep — watch for CISD")
alertcondition(bullValidNow,                 "Long CISD (valid)",    "Long CISD confirmed — order placed at entry")
alertcondition(bearValidNow,                 "Short CISD (valid)",   "Short CISD confirmed — order placed at entry")
